# Supabase (public — safe for client bundle)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudflare Pages Function env vars (server-side only — set in Cloudflare dashboard, never in client code)
RESEND_API_KEY=
